    <!-- ADB Examples Monospace Block -->
    <string name="adb_examples" formatted="false"># 通过 uid 1000 特权通道发送命令
adb shell content call --uri content://com.poc.gctune.bridge --method exec --arg "id" --extra wait:i:8

# 查询执行结果: ack|STATUS|rc|base64
adb shell settings get secure gc_tune_adb_out

# 或使用仓库附带的 PowerShell 脚本
./adbplus.ps1 "id"</string>

